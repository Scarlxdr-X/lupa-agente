# Copia este archivo como .env y completa tus claves. El archivo .env NO se sube a GitHub.
# En Google Colab no hace falta: guarda las mismas variables en "Secretos" (icono de llave).

# --- Proveedor de LLM que usa el agente: "gemini" o "openai_compat" ---
LUPA_PROVEEDOR=gemini

# --- Gemini (principal) ---
# Clave: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo. Para ver cuáles tiene disponibles tu clave: lupa-verificar --listar-modelos
LUPA_MODELO_GEMINI=gemini-3.7-flash

# --- Groq u otra API compatible con OpenAI (respaldo) ---
# Clave de Groq: https://console.groq.com/keys
GROQ_API_KEY=
LUPA_OPENAI_BASE_URL=https://api.groq.com/openai/v1
LUPA_MODELO_OPENAI=openai/gpt-oss-120b

# --- Búsqueda web (fase 2) ---
# Clave: https://app.tavily.com
TAVILY_API_KEY=

# --- datos.gov.co (opcional) ---
# La API funciona sin token; un token gratuito solo sube el límite de peticiones.
SODA_APP_TOKEN=

# --- Agente ---
LUPA_MAX_PASOS=15
# Horas que se reutiliza una respuesta de datos.gov.co guardada en cache/ (0 = sin caché)
LUPA_CACHE_HORAS=24
